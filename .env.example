# OpenRouter LLM (Swara's Brain — primary provider)
# Get your free API key at: https://openrouter.ai
VITE_OPENROUTER_API_KEY=sk_or_PASTE_YOUR_OPENROUTER_API_KEY_HERE
VITE_SITE_URL=http://localhost:3000

# Groq Cloud LLM (DEPRECATED — kept as fallback reference)
# GROQ_API_KEY=gsk_PASTE_YOUR_GROQ_API_KEY_HERE

# AWS Polly TTS (Swara's Voice)
AWS_ACCESS_KEY_ID=PASTE_YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=PASTE_YOUR_AWS_SECRET_ACCESS_KEY_HERE
AWS_REGION=us-east-1

# Optional dev proxy target for API routes
VITE_API_PROXY_TARGET=http://localhost:3000

# Optional hosted backend base URL for TTS (leave empty to use /api/tts)
# VITE_TTS_API_URL=https://your-backend-domain.com/api/tts

# Optional Firebase/Supabase placeholders if you wire them through env later
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
