# AWS Polly TTS
AWS_ACCESS_KEY_ID=PASTE_YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=PASTE_YOUR_AWS_SECRET_ACCESS_KEY_HERE
AWS_REGION=us-east-1

# LLM / AI
VITE_GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE

# Vision / Emotion analysis
LUXAND_API_KEY=PASTE_YOUR_LUXAND_API_KEY_HERE
# Optional frontend alias if you prefer exposing it to Vite env
VITE_LUXAND_API_KEY=PASTE_YOUR_LUXAND_API_KEY_HERE

# Optional dev proxy target for API routes
VITE_API_PROXY_TARGET=http://localhost:3000

# Optional hosted backend base URL for TTS (leave empty to use /api/tts)
# VITE_TTS_API_URL=https://your-backend-domain.com/api/tts

# Optional Firebase/Supabase placeholders if you wire them through env later
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
